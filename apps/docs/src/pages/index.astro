---
/** The site root: a short landing page in front of the Starlight docs. */
import { Code } from 'astro:components';
import wordmarkSource from '../assets/logo-mono.svg?raw';
import Labs from '../assets/swm-ai-labs-dark.svg';
import { monoTheme } from '../landing/monoTheme';
import { socialLinks } from '../landing/socialLinks';
import zooSampleSource from '../landing/samples/zoo.ts?raw';
import '../styles/fonts.css';
import '../styles/tokens.css';

const base = import.meta.env.BASE_URL;

/** The wordmark drawn in two parts: "ru" and "time" as one white path, and
 *  the NN as a marble-filled box masked to the letters, so the word keeps its
 *  exact metrics. Its third and fourth subpaths are the two N's. */
const wordmarkViewBox = wordmarkSource.match(/viewBox="([^"]+)"/)![1]!;
const wordmarkSubpaths = wordmarkSource.match(/ d="([^"]+)"/)![1]!.split(/(?=M)/);
const wordmarkNn = wordmarkSubpaths.slice(2, 4).join('');
const wordmarkRest = [...wordmarkSubpaths.slice(0, 2), ...wordmarkSubpaths.slice(4)].join('');
/** The NN's bounding box in the wordmark's units, from its path. */
const NN_BOX = { x: 102.9, y: 2.8, width: 131.1, height: 70 };
const [, , wordmarkWidth, wordmarkHeight] = wordmarkViewBox.split(' ').map(Number) as [
  number,
  number,
  number,
  number,
];
const heroNnBox = [
  `left: ${(100 * NN_BOX.x) / wordmarkWidth}%`,
  `top: ${(100 * NN_BOX.y) / wordmarkHeight}%`,
  `width: ${(100 * NN_BOX.width) / wordmarkWidth}%`,
  `height: ${(100 * NN_BOX.height) / wordmarkHeight}%`,
].join('; ');
/** A CSS mask of an SVG path, cropped to `viewBox`. */
const pathMask = (viewBox: string, path: string) =>
  `url("data:image/svg+xml,${encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${viewBox}" preserveAspectRatio="none"><path d="${path}"/></svg>`,
  )}")`;
const heroNnMask = pathMask(
  `${NN_BOX.x} ${NN_BOX.y} ${NN_BOX.width} ${NN_BOX.height}`,
  wordmarkNn,
);
/** The favicon's NN glyph, cropped to its bounding box. */
const navNnMask = pathMask(
  '3 10 26 13',
  'M3 10h12v3.2H6.2V23H3V10Zm8.8 3.2H15V23h-3.2v-9.8ZM17 10h12v3.2h-8.8V23H17V10Zm8.8 3.2H29V23h-3.2v-9.8Z',
);
const docs = `${base}zoo/getting-started/`;
const github = 'https://github.com/software-mansion/runntime';
const npm = 'https://www.npmjs.com/package/runntime';
const huggingFace = 'https://huggingface.co/software-mansion';
const discord = 'https://discord.gg/ZGqqY55qkP';
const labs = 'https://ai.swmansion.com/?utm_source=runntime&utm_medium=landing';

/** runntime/core is not exported yet, so this sample cannot be type-checked
 *  against the package. It declares everything it uses. */
const coreSample = `import { nn, tensor, toArray, type Value } from 'runntime/core';

class Block extends nn.Module {
  fc1 = new nn.Linear(384, 1536, { activation: 'gelu' });
  fc2 = new nn.Linear(1536, 384);

  forward(x: Value) {
    return this.fc2.forward(this.fc1.forward(x), { addend: x });
  }
}

// 1. Weights load by name, straight from the PyTorch checkpoint.
const block = new Block();
await block.loadStateDict('/block.safetensors');

// 2. forward() only records the graph. toArray() submits it once.
const tokens = 16;
const x = tensor(new Float32Array(tokens * 384), [tokens, 384]);
const y = await toArray(block.forward(x));`;

/** The zoo sample is type-checked in its own file; the page shows what follows the cut. */
const zooSample = zooSampleSource.split('// ---cut---\n')[1]!.trim();

/** The task table from the README's "Supported models", with each task's docs page. */
const tasks = [
  ['Embedding', 'createEmbedder', 'EmbeddingGemma 2, all-MiniLM-L6-v2', 'zoo/embedding/'],
  ['Privacy filter', 'createPrivacyFilter', 'OpenAI privacy-filter (int8)', 'zoo/privacy-filter/'],
  [
    'Speech to text',
    'createSpeechToText',
    'Moonshine tiny / base, streaming tiny',
    'zoo/speech-to-text/',
  ],
  ['Text to speech', 'createTextToSpeech', 'Reverb-TTS', 'zoo/text-to-speech/'],
  ['Object detection', 'createObjectDetector', 'YOLO26 n / s / m', 'zoo/object-detection/'],
  [
    'Instance segmentation',
    'createInstanceSegmenter',
    'YOLO26-seg n / s / m',
    'zoo/instance-segmentation/',
  ],
  ['Pose & keypoints', 'createKeypointDetector', 'YOLO26-pose n / s / m', 'zoo/pose-and-keypoints/'],
  ['Depth estimation', 'createDepthEstimator', 'DepthART s / b', 'zoo/depth-estimation/'],
  ['Image classification', 'createImageClassifier', 'MobileNetV4 small', 'zoo/image-classification/'],
] as const;

/** The README's "Performance" table, verbatim: how many times longer ONNX
 *  Runtime Web and LiteRT.js take than ruNNtime, all-MiniLM-L6-v2 on an Apple
 *  M4 Pro in Chrome. LiteRT has no number for batches of 32. No absolute
 *  timings for these runs are published, so the chart shows only these ratios. */
const speedups = [
  ['1 sentence (32 tokens)', '2.25×', '2.3×'],
  ['128 tokens', '1.83×', '3.9×'],
  ['32 × 128 tokens', '1.26×', '4.0×'],
  ['Real text, one at a time', '2.05×', '4.1×'],
  ['Real text, in batches of 32', '2.36×', undefined],
] as const;

/** The chart's engines, top to bottom in each group. ruNNtime is the baseline. */
const perfEngines = [
  { name: 'ONNX Runtime Web', key: 'onnx' },
  { name: 'LiteRT.js', key: 'litert' },
  { name: 'ruNNtime', key: 'ours' },
] as const;
/** One group of bars per input, ruNNtime at 1× and the others at their ratio. */
const perfGroups = speedups.map(([input, onnx, litert]) => ({
  input,
  bars: [
    { ...perfEngines[0], ratio: onnx },
    { ...perfEngines[1], ratio: litert },
    { ...perfEngines[2], ratio: '1×' },
  ],
}));
/** The shared scale: the largest published ratio spans the full width. */
const perfScaleMax = Math.max(
  ...speedups.flatMap(([, onnx, litert]) => [onnx, litert ?? '0']).map((ratio) => parseFloat(ratio)),
);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ruNNtime</title>
    <meta
      name="description"
      content="A high-performance framework for running AI models on the web, in Electron and in React Native."
    />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <canvas class="stage" aria-hidden="true"></canvas>

    <header class="bar">
      <a class="bar-mark" href={base} aria-label="ruNNtime home">
        <!-- The favicon's NN, filled with the marble: the hero spells out ruNNtime. -->
        <span class="nn-fill nn-nav" style={`mask-image: ${navNnMask}`}>
          <canvas class="nn-canvas" aria-hidden="true"></canvas>
        </span>
      </a>
      <nav class="bar-pill" aria-label="Main">
        <canvas class="bar-canvas" aria-hidden="true"></canvas>
        <a href={docs}>Docs</a>
        <a href={github}>GitHub</a>
        <a href={npm}>npm</a>
        <a href={huggingFace}>Hugging Face</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="hero-copy">
          <h1>
            <span class="sr-only">ruNNtime</span>
            <span class="hero-wordmark" aria-hidden="true">
              <svg viewBox={wordmarkViewBox}><path class="wordmark-dots" d={wordmarkRest}></path></svg>
              <span class="nn-fill nn-hero" style={`mask-image: ${heroNnMask}; ${heroNnBox}`}>
                <canvas class="nn-canvas"></canvas>
              </span>
            </span>
          </h1>
          <p class="hero-lead">
            A high-performance framework for running AI models on the web, in Electron and in React
            Native.
          </p>
          <p class="created-by">
            <span>Created by</span>
            <a class="labs-lockup" href={labs}>
              <Labs aria-hidden="true" />
              <span class="labs-name"
                ><span>software</span><span>mansion</span><span class="labs-big">ai labs</span></span
              >
            </a>
          </p>
          <div class="hero-actions">
            <a class="button primary glitter" href={docs}>
              <canvas class="glitter-canvas" aria-hidden="true"></canvas>
              <span class="glitter-label">Get started</span>
            </a>
            <code class="install">npm install runntime typegpu</code>
          </div>
        </div>
      </section>

      <div class="panels">
        <section class="part" aria-labelledby="performance-title">
          <div class="part-text">
            <h2 id="performance-title">Performance</h2>
            <p class="part-lead">
              Against ONNX Runtime Web and LiteRT.js on the same GPU, tensor in to tensor out
              (<span class="nowrap">all-MiniLM-L6-v2</span>, Apple M4 Pro, Chrome).
            </p>
            <dl class="facts">
              <dt>Built for WebGPU only</dt>
              <dd>No generic backend layer, kernels tuned for what models actually run.</dd>
              <dt>Fused kernels</dt>
              <dd>
                Bias, activations and residual adds ride along in the kernel before them, so fewer
                dispatches.
              </dd>
              <dt>One submit per call</dt>
              <dd>The whole forward pass goes to the GPU at once.</dd>
              <dt>Specialized shaders</dt>
              <dd>TypeGPU generates a lean shader for every variant from one source.</dd>
            </dl>
          </div>
          <div class="part-code">
            <figure class="perf">
              <ul class="perf-legend">
                {
                  perfEngines.map(({ name, key }) => (
                    <li>
                      <span class:list={['perf-swatch', `perf-${key}`]} />
                      {name}
                    </li>
                  ))
                }
              </ul>
              <div class="perf-chart">
                {
                  perfGroups.map(({ input, bars }) => (
                    <div class="perf-group">
                      <h3 class="perf-config">{input}</h3>
                      <ul class="perf-bars">
                        {bars.map(({ name, key, ratio }) => (
                          <li
                            class:list={['perf-row', `perf-${key}`]}
                            title={
                              ratio
                                ? `${name}: ${ratio} the time of ruNNtime`
                                : `${name}: no published number`
                            }
                          >
                            <span class="sr-only">{name}:</span>
                            {ratio && (
                              <span
                                class="perf-bar"
                                style={`width: ${(100 * parseFloat(ratio)) / perfScaleMax}%`}
                              />
                            )}
                            <span class="perf-value">{ratio ?? 'n/a'}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
              <figcaption class="perf-caption">
                Time per call relative to ruNNtime, so shorter is faster.{' '}
                <a href={`${base}zoo/benchmarks/`}>More benchmarks and how they are measured</a>
              </figcaption>
            </figure>
          </div>
        </section>

        <section class="part" aria-labelledby="core-title">
          <div class="part-text">
            <h2 id="core-title">runntime/core</h2>
            <p class="status">Not public yet, coming soon.</p>
            <p class="part-lead">
              The building blocks behind the zoo, for composing your own models with PyTorch-like
              semantics.
            </p>
            <dl class="facts">
              <dt>No model conversion</dt>
              <dd>
                Models run straight from their PyTorch weights. No export step to break, and input
                shapes are set at runtime, not baked in ahead of time.
              </dd>
              <dt>Data stays on the GPU</dt>
              <dd>Feed in a video frame, get results in a GPU buffer, ready for your own rendering.</dd>
            </dl>
          </div>
          <div class="part-code">
            <Code code={coreSample} lang="ts" theme={monoTheme} />
          </div>
        </section>

        <section class="part" aria-labelledby="zoo-title">
          <div class="part-text">
            <h2 id="zoo-title">runntime/zoo</h2>
            <p class="part-lead">
              Ready-to-run models for speech, vision and text. One function call gives you a running
              model.
            </p>
            <dl class="facts">
              <dt>One line to a running model</dt>
              <dd>
                Pick a model, call one function, and it downloads and runs. Turn on caching to skip
                the download next time.
              </dd>
              <dt>Works with transformers.js</dt>
              <dd>
                Already using it? One call swaps the engine and your code stays as it is. See{' '}
                <a href={`${base}zoo/migrating-from-transformers-js/`}>
                  migrating from transformers.js
                </a>.
              </dd>
            </dl>
            <a class="button" href={docs}>Get started</a>
          </div>
          <div class="part-code">
            <Code code={zooSample} lang="ts" theme={monoTheme} />
          </div>
        </section>

        <section class="part models" aria-labelledby="models-title">
          <div class="part-text">
            <h2 id="models-title">Supported models</h2>
            <p class="part-lead">
              The zoo package currently supports 19 models across 9 tasks, each loaded with one
              function call.
            </p>
          </div>
          <ul class="model-grid">
            {
              tasks.map(([task, , modelNames, slug]) => (
                <li>
                  <a href={`${base}${slug}`}>{task}</a>
                  <p>
                    {modelNames.split(', ').map((name, i) => (
                      <>
                        {i > 0 && ', '}
                        <span class="nowrap">{name}</span>
                      </>
                    ))}
                  </p>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </main>

    <footer class="site-foot">
      <div class="foot">
        <section class="foot-labs" aria-labelledby="labs-title">
          <h2 id="labs-title">Software Mansion AI Labs</h2>
          <p>
            We're an end-to-end AI development lab focused on local and hybrid AI. We build and
            fine-tune models, deploy them anywhere and turn them into agents that solve real business
            problems.
          </p>
          <a class="button primary" href={`${labs}#contact`}>Hire us</a>
        </section>
        <div class="foot-bottom">
          <div class="foot-brand">
            <a class="labs-lockup" href={labs}>
              <Labs aria-hidden="true" />
              <span class="labs-name"
                ><span>software</span><span>mansion</span><span class="labs-big">ai labs</span></span
              >
            </a>
            <ul class="foot-links">
              <li><a href={labs}>Software Mansion AI Labs</a></li>
              <li><a href={docs}>Docs</a></li>
              <li><a href={github}>GitHub</a></li>
              <li><a href={npm}>npm</a></li>
              <li><a href={huggingFace}>Hugging Face</a></li>
              <li><a href={discord}>Discord</a></li>
            </ul>
          </div>
          <div class="foot-icons">
            {
              socialLinks.map(({ label, href, path, fillRule }) => (
                <a href={href} aria-label={label}>
                  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
                    <path d={path} fill="currentColor" fill-rule={fillRule} />
                  </svg>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </footer>

    <script>
      import tgpu, { type TgpuRoot } from 'typegpu';
      import { startHero } from '../landing/networkShader';
      import { startMarble } from '../landing/marbleShader';
      import { attachPixelGlitter } from '../landing/pixelGlitter';

      const page = document.documentElement;
      const stage = document.querySelector<HTMLCanvasElement>('.stage')!;
      const barCanvas = document.querySelector<HTMLCanvasElement>('.bar-canvas')!;
      const navNnCanvas = document.querySelector<HTMLCanvasElement>('.nn-nav canvas')!;
      const heroNnCanvas = document.querySelector<HTMLCanvasElement>('.nn-hero canvas')!;
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let stops: (() => void)[] = [];

      const stopAll = () => {
        for (const stop of stops) stop();
        stops = [];
      };

      /** Starts both shaders. WGSL validation errors are async, so the first
       *  frames run inside an error scope and a failure is thrown here. */
      async function startShaders(root: TgpuRoot) {
        const still = reducedMotion.matches;
        root.device.pushErrorScope('validation');
        try {
          stops.push(startHero(root, stage, { still }));
          // The pill drives the loop: it is fixed, so always on screen. The
          // letters take a lighter range, so no stroke sinks into the black.
          const marbleTargets = [
            { canvas: barCanvas, cells: [4, 1.4], dark: 0.04, light: 0.85 },
            { canvas: navNnCanvas, cells: [1.6, 1.6], dark: 0.5, light: 1 },
            { canvas: heroNnCanvas, cells: [1.6, 1.6], dark: 0.5, light: 1 },
          ] as const;
          stops.push(startMarble(root, marbleTargets, { still }));
        } finally {
          const error = await root.device.popErrorScope();
          if (error) throw error;
        }
      }

      async function start() {
        if (!navigator.gpu) {
          page.dataset.gpu = 'off';
          return;
        }
        const root = await tgpu.init();
        try {
          await startShaders(root);
        } catch (error) {
          stopAll();
          root.destroy();
          throw error;
        }
        page.dataset.gpu = 'on';
        reducedMotion.addEventListener('change', () => {
          stopAll();
          startShaders(root).catch(() => {
            stopAll();
            page.dataset.gpu = 'off';
          });
        });
        void root.device.lost.then(() => {
          stopAll();
          page.dataset.gpu = 'off';
        });
      }

      start().catch(() => {
        page.dataset.gpu = 'off';
      });

      // Touch screens have no hover, so the button keeps its plain fill there.
      if (matchMedia('(hover: hover)').matches) {
        const button = document.querySelector<HTMLElement>('.glitter')!;
        const canvas = button.querySelector('canvas')!;
        let detach = attachPixelGlitter(button, canvas, { still: reducedMotion.matches });
        reducedMotion.addEventListener('change', () => {
          detach();
          detach = attachPixelGlitter(button, canvas, { still: reducedMotion.matches });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    /* Anchors land below the fixed navbar. */
    scroll-padding-top: 5.5rem;
    background: var(--n-00);
    color: var(--text-body);
    font-family: 'Aeonik', system-ui, sans-serif;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
  }
  /* No body background: it would paint over the fixed canvas behind the page. */
  body {
    margin: 0;
  }
</style>

<style>
  a {
    color: inherit;
  }
  a:focus-visible,
  .button:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }
  code {
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 0.875em;
  }
  .nowrap {
    white-space: nowrap;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The network, fixed behind the whole page while the content scrolls over it. */
  .stage {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    opacity: 0;
    transition: opacity 1.2s ease-out;
  }
  :global(:root[data-gpu='on']) .stage {
    opacity: 1;
  }
  :global(:root[data-gpu='off']) .stage,
  :global(:root[data-gpu='off']) .bar-canvas {
    display: none;
  }

  /*
   * The navbar: the NN mark on the left and a pill of links on the right,
   * both fixed at the top with nothing between them. The pill's fill is the
   * marble shader; until it runs, or without WebGPU, offset ellipses of gray
   * stand in. Each link sits on a soft dark backing, so it reads on silver.
   */
  .bar {
    position: fixed;
    inset: 0.75rem 0.75rem auto;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 90rem;
    margin: 0 auto;
    pointer-events: none;
  }
  .bar > * {
    pointer-events: auto;
  }
  .bar-mark {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.5rem;
  }
  .bar-pill {
    position: relative;
    display: flex;
    gap: 0.25rem;
    padding: 0.4rem;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 999px;
    background-color: var(--n-08);
    background-image:
      radial-gradient(40% 150% at 14% 10%, rgb(140 140 140 / 0.5), transparent 70%),
      radial-gradient(30% 120% at 55% 105%, rgb(200 200 200 / 0.24), transparent 70%),
      radial-gradient(40% 180% at 90% 0%, rgb(100 100 100 / 0.45), transparent 72%);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.5);
  }
  .bar-canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease-out;
  }
  :global(:root[data-gpu='on']) .bar-canvas {
    opacity: 1;
  }
  .bar-pill a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.42);
    color: var(--text-primary);
    text-decoration: none;
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.9);
    white-space: nowrap;
  }
  .bar-pill a:hover {
    background: rgb(0 0 0 / 0.7);
  }

  /*
   * NN letters filled with the marble: a box masked to the glyphs. The
   * gradient underneath is the fill until the marble runs, or without WebGPU.
   */
  .nn-fill {
    display: block;
    background: var(--grad-mark-chalk);
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
  }
  .nn-canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease-out;
  }
  :global(:root[data-gpu='on']) .nn-canvas {
    opacity: 1;
  }
  :global(:root[data-gpu='off']) .nn-canvas {
    display: none;
  }
  .nn-nav {
    width: 3rem;
    height: 1.5rem;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    display: grid;
    align-content: center;
    min-height: max(40rem, 100svh);
    padding: 6rem clamp(1rem, 4vw, 3rem) 5rem;
    isolation: isolate;
  }
  /* Until the network runs, or without WebGPU, a faint CSS poster stands in. */
  :global(:root:not([data-gpu='on'])) .hero {
    background:
      radial-gradient(ellipse 40% 45% at 72% 50%, rgb(255 255 255 / 0.1), transparent 70%),
      repeating-linear-gradient(90deg, transparent 0 3px, rgb(255 255 255 / 0.025) 3px 4px);
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.6) 40%, transparent 65%);
    pointer-events: none;
  }
  .hero-copy {
    max-width: 34rem;
  }
  .hero h1 {
    margin: 0 0 2rem;
    color: var(--text-primary);
    line-height: 0;
  }
  .hero-wordmark {
