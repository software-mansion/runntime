{
  "name": "runntime",
  "version": "0.0.1",
  "description": "AI models on the web, built with TypeGPU.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/software-mansion/runntime.git",
    "directory": "packages/runntime"
  },
  "homepage": "https://docs.swmansion.com/runntime",
  "bugs": "https://github.com/software-mansion/runntime/issues",
  "keywords": [
    "webgpu",
    "typegpu",
    "wgsl",
    "gpu",
    "machine-learning",
    "inference",
    "on-device",
    "neural-network",
    "transformers",
    "object-detection",
    "speech-to-text",
    "text-embedding",
    "image-classification",
    "depth-estimation",
    "react-native"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./zoo": {
      "types": "./dist/zoo/index.d.mts",
      "default": "./dist/zoo/index.mjs"
    },
    "./zoo/transformers": {
      "types": "./dist/zoo/transformers/index.d.mts",
      "default": "./dist/zoo/transformers/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.20"
  },
  "peerDependencies": {
    "typegpu": "^0.12.5",
    "@huggingface/transformers": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@types/node": "^25.9.2",
    "@webgpu/types": "^0.1.60",
    "tsdown": "^0.23.0",
    "unplugin-typegpu": "^0.12.3",
    "typegpu": "^0.12.5"
  }
}
